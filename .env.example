# 1. Contacts sheet: the Apps Script web app URL (ends in /exec) and a shared secret.
#    The same secret goes into the Apps Script project's Script properties as SHARED_SECRET.
CONTACTS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxpCA58EM2uSgz2zjRVNDB_zVf491RpzjLrZhjCLjZrNY4AdTRmRlyaXdi86c4LU10iyw/exec
CONTACTS_WEBHOOK_SECRET=FlowIQAutomationsharedsecret01

# 2. Brevo email (Brevo → Settings → SMTP & API → API keys)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=121@taxlegit.com
BREVO_SENDER_NAME=FlowIQ Automation
# BREVO_REPLY_TO=121@taxlegit.com

# 3. Signs each user's session so emails only go to their own address (any long random string)
SESSION_SECRET=change-me-to-another-long-random-string

# Optional: set to false to close the welcome form
REGISTRATION_OPEN=true
